# ==============================================================================
# Farsly Backend Environment Configuration
# Copy this file to .env for local development, or configure these in Coolify
# ==============================================================================

# Server Port (Coolify assigns this automatically or defaults to 3000)
PORT=3000

# Environment Mode ('development' or 'production')
NODE_ENV=production

# JWT Authentication Secret (Required: Generate a strong random key for production)
JWT_SECRET=change-me-to-a-strong-random-string

# Database Path / URL (SQLite)
# In Coolify, mount a persistent volume (e.g. /app/data or /data) and point DB_PATH to it
# so all database records survive container redeployments!
# Examples:
#   DB_PATH=/app/data/farsly.db
#   DATABASE_URL=sqlite:///app/data/farsly.db
DB_PATH=./farsly.db

# CORS Allowed Origins
# Comma-separated list of allowed frontend domains, or '*' for open access
CORS_ORIGIN=https://farsly.kotaawan.net,http://localhost:5173

# Public API URL (Canonical public domain of this API)
PUBLIC_API_URL=https://farsly-api.kotaawan.net

# Optional: Initial Seed Passwords (used when running 'npm run seed')
SEED_CUSTOMER_PASSWORD=password123
SEED_ADMIN_PASSWORD=password123
